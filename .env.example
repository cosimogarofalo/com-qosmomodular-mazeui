# In development Vite proxies /api to this Maze REST origin.
VITE_MAZE_PROXY_TARGET=http://127.0.0.1:8081

# Keep /api for same-origin production deployments.
VITE_MAZE_API_URL=/api

# MazeAI REST is a separate advisory service on port 8082.
VITE_MAZEAI_PROXY_TARGET=http://127.0.0.1:8082

# Keep the distinct prefix in production and route it to MazeAI REST.
VITE_MAZEAI_API_URL=/mazeai-api
